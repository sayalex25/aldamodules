<odoo>
  <record id="view_budget_hotel_tree" model="ir.ui.view">
    <field name="name">budget.hotel.tree</field>
    <field name="model">budget.hotel</field>
    <field name="arch" type="xml">
      <tree>
        <field name="name" />
        <field name="code" />
      </tree>
    </field>
  </record>
  <record id="view_budget_hotel_form" model="ir.ui.view">
    <field name="name">budget.hotel.form</field>
    <field name="model">budget.hotel</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="name" />
          <field name="code" />
        </group>
      </form>
    </field>
  </record>
  <!-- Menú principal de Presupuesto -->
  <menuitem
        id="menu_budget_hotel"
        name="Hotels"
        parent="menu_budget_root"
        sequence="0"
    />
  <record id="action_budget_hotel" model="ir.actions.act_window">
    <field name="name">Hotels</field>
    <field name="res_model">budget.hotel</field>
    <field name="view_mode">tree,form</field>
  </record>
  <menuitem
        id="menu_budget_hotel_action"
        parent="menu_budget_hotel"
        action="action_budget_hotel"
        sequence="1"
    />
</odoo>
