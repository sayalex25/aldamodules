<odoo>
  <menuitem id="menu_budget_root" name="Budget" sequence="10" />
  <record id="view_budget_hotel_tree" model="ir.ui.view">
    <field name="name">budget.hotel.tree</field>
    <field name="model">budget.hotel</field>
    <field name="arch" type="xml">
      <tree string="Hotels Budget" create="1" edit="1" delete="1">
        <field name="hotel" />
        <field name="hotel_id" />
        <field name="hotel_code" />
        <field name="company" />
      </tree>
    </field>
  </record>

  <record id="view_budget_hotel_form" model="ir.ui.view">
    <field name="name">budget.hotel.form</field>
    <field name="model">budget.hotel</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <field name="hotel" options="{'no_create': True, 'no_create_edit': True}" />
            <field name="hotel_id" />
            <field name="hotel_code" />
            <field name="company" />
          </group>
        </sheet>
      </form>
    </field>
  </record>
  <record id="action_budget_hotel" model="ir.actions.act_window">
    <field name="name">Hotels Budget</field>
    <field name="res_model">budget.hotel</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_smiling_face">
        Create your first hotel budget entry.
      </p>
      <p>
        Hotels from PMS Properties.
      </p>
    </field>
  </record>

  <menuitem
        id="menu_budget_hotel"
        name="Hotels"
        parent="menu_budget_root"
        action="action_budget_hotel"
        sequence="0"
    />
</odoo>
